// Keyvaga data model: Phase 1 (accounts, roles, sessions) plus the first
// listing and booking tables. More models (payments, messages, services,
// connections) arrive in later phases.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Accounts ----------

enum Role {
  GUEST
  OWNER
  PROVIDER
  ADMIN
}

model User {
  id                 String                   @id @default(cuid())
  email              String                   @unique
  name               String
  passwordHash       String
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  roles              UserRole[]
  sessions           Session[]
  listings           Listing[]                @relation("ListingOwner")
  bookings           Booking[]                @relation("BookingGuest")
  messages           Message[]
  reviews            Review[]
  saved              SavedListing[]
  providerProfile    ProviderProfile?
  messageTemplates   MessageTemplate[]
  passwordResets     PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
  /// When the user confirmed their email by clicking the link we sent. Needed to book, submit a listing or offer services.
  emailVerifiedAt    DateTime?
  lockAccounts       LockAccount[]
  locks              Lock[]
  lockEvents         LockEvent[]
  jobPhotos          JobPhoto[]
  jobsPosted         Job[]                    @relation("JobOwner")
  jobMessages        JobMessage[]
  jobReviewsGiven    JobReview[]              @relation("JobReviewer")
  /// Stripe customer used to save the guest's card for the balance charge.
  stripeCustomerId   String?                  @unique
  /// Stripe Connect account that receives the owner's payouts.
  stripeAccountId    String?                  @unique
  payoutsEnabled     Boolean                  @default(false)
}

/// One person can hold several roles (e.g. a guest who is also an owner).
model UserRole {
  userId    String
  role      Role
  grantedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
}

/// Server-side sessions. `id` is the SHA-256 hash of the cookie token,
/// so a database leak does not expose usable session tokens.
model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Listings ----------

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  PAUSED
}

enum PropertyType {
  HOUSE
  APARTMENT
  CABIN
  CONDO
  VILLA
  OTHER
}

model Listing {
  id                  String             @id @default(cuid())
  ownerId             String
  slug                String             @unique
  title               String
  summary             String
  description         String             @default("")
  propertyType        PropertyType
  city                String
  region              String
  country             String             @default("US")
  bedrooms            Int
  bathrooms           Decimal            @db.Decimal(3, 1)
  maxGuests           Int
  /// All money is stored in minor units (cents). Launch currency is USD.
  nightlyRateCents    Int
  cleaningFeeCents    Int                @default(0)
  currency            String             @default("USD") @db.Char(3)
  /// Instant book is the launch default; kept per listing so request-to-book can be added later.
  instantBook         Boolean            @default(true)
  /// Charged once per stay, only when the guest says they're bringing a pet (cents; 0 = no pet fee).
  petFeeCents         Int                @default(0)
  /// Condo building or resort this unit is in (shared page lists every Keyvaga unit there).
  complexId           String?
  complex             Complex?           @relation(fields: [complexId], references: [id], onDelete: SetNull)
  minNights           Int                @default(1)
  cancellationPolicy  CancellationPolicy @default(MODERATE)
  /// Friday and Saturday nights; null = same as nightlyRateCents.
  weekendRateCents    Int?
  /// Discounts on the nights (not cleaning) for longer stays, in basis points (1000 = 10%).
  weeklyDiscountBps   Int                @default(0)
  monthlyDiscountBps  Int                @default(0)
  /// Private: shown to guests with a confirmed booking from accessReleaseDays before check-in.
  checkInInstructions String             @default("")
  accessReleaseDays   Int                @default(3)
  /// Digital guidebook: local tips written by the owner, shown to booked guests.
  guidebook           String             @default("")
  seasonalRates       SeasonalRate[]
  dateRates           DateRate[]
  jobs                Job[]
  /// The owner's usual cleaner for this property; turnover cleans can be requested automatically.
  regularCleanerId    String?
  regularCleaner      ProviderProfile?   @relation("RegularCleaner", fields: [regularCleanerId], references: [id], onDelete: SetNull)
  /// When a booking is confirmed, send a turnover cleaning request for checkout day to the regular cleaner.
  autoRequestCleaning Boolean            @default(false)
  reviews             Review[]
  savedBy             SavedListing[]
  messageTemplates    MessageTemplate[]
  locks               Lock[]
  /// IANA time zone for check-in/checkout times (door codes switch on and off at local time).
  timeZone            String             @default("America/Chicago")
  /// Turnover checklist, one item per entry. Empty = Keyvaga's suggested checklist.
  cleaningChecklist   String[]           @default([])
  /// Photos a cleaner must upload before marking a cleaning done.
  cleaningMinPhotos   Int                @default(4)
  /// Secret for this listing's calendar export URL (/ical/<token>.ics). Created on first use; reset to revoke.
  icalToken           String?            @unique
  /// Linked Hospitable property (owner's own account via personal access token, for now).
  /// Deleted by the owner (e.g. property sold) but kept because bookings reference it. Hidden everywhere.
  deletedAt            DateTime?
  hospitablePropertyId String?           @unique
  hospitableSyncedAt   DateTime?
  hospitableSyncError  String?
  calendarFeeds       CalendarFeed[]
  /// Amenity keys from the catalog in src/lib/amenities.ts
  amenities           String[]           @default([])
  houseRules          String             @default("")
  /// "HH:MM" 24-hour local time
  checkInTime         String             @default("16:00")
  checkOutTime        String             @default("10:00")
  /// Exact address: private, only released to guests with a confirmed booking (Phase 4).
  addressLine1        String             @default("")
  addressLine2        String             @default("")
  postalCode          String             @default("")
  latitude            Float?
  longitude           Float?
  status              ListingStatus      @default(DRAFT)
  /// Feedback from the admin when a listing is sent back to the owner.
  reviewNote          String?
  submittedAt         DateTime?
  publishedAt         DateTime?
  featured            Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  owner               User               @relation("ListingOwner", fields: [ownerId], references: [id])
  bookings            Booking[]
  calendarBlocks      CalendarBlock[]
  photos              ListingPhoto[]
  /// Optional short video tour (max 20 seconds). videoKey is the storage pathname.
  videoKey            String?
  /// Direct URL for public/local storage; private stores get a short-lived signed URL at view time.
  videoUrl            String?
  videoAccess         String?
  videoContentType    String?
  videoDurationSec    Float?
  /// Proof of the right to rent this property.
  hostingRole         HostingRole?
  /// Management company name when hostingRole = MANAGER.
  managerCompany      String             @default("")
  /// Owner says the area requires a short-term rental permit; then a permit document is required.
  permitRequired      Boolean            @default(false)
  /// Shown publicly on the stay page once the permit document is approved.
  permitNumber        String             @default("")
  documents           ListingDocument[]

  @@index([status, city])
  @@index([ownerId])
  @@index([complexId])
}

/// A date range with its own nightly rate, e.g. summer or holidays. [startDate, endDate) like bookings.
model SeasonalRate {
  id               String   @id @default(cuid())
  listingId        String
  name             String
  startDate        DateTime @db.Date
  endDate          DateTime @db.Date
  nightlyRateCents Int
  createdAt        DateTime @default(now())
  listing          Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, startDate])
}

enum HostingRole {
  OWNER
  MANAGER
}

enum DocumentType {
  OWNERSHIP_PROOF
  RENTAL_PERMIT
  MANAGEMENT_LICENSE
  MANAGEMENT_AGREEMENT
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Private verification documents (deed, permit, management license...). Never public:
/// stored in private storage and served only to the listing owner and admins, with every access logged.
model ListingDocument {
  id             String              @id @default(cuid())
  listingId      String
  type           DocumentType
  /// Storage key (private store / private local folder).
  fileKey        String
  fileName       String
  contentType    String
  sizeBytes      Int
  /// License or permit number, where relevant.
  documentNumber String              @default("")
  expiresAt      DateTime?           @db.Date
  status         DocumentStatus      @default(PENDING)
  reviewNote     String?
  uploadedById   String
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime            @default(now())
  listing        Listing             @relation(fields: [listingId], references: [id], onDelete: Cascade)
  accessLogs     DocumentAccessLog[]

  @@index([listingId, type])
  @@index([status])
}

/// Audit trail: who uploaded, viewed, approved, rejected or deleted each document.
model DocumentAccessLog {
  id         String           @id @default(cuid())
  documentId String?
  listingId  String
  userId     String
  action     String
  createdAt  DateTime         @default(now())
  document   ListingDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([listingId, createdAt])
}

/// A custom price for one specific night, set from the owner calendar. Wins over seasonal, weekend and base rates.
model DateRate {
  listingId String
  date      DateTime @db.Date
  rateCents Int
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([listingId, date])
}

model ListingPhoto {
  id         String   @id @default(cuid())
  listingId  String
  url        String
  /// Key in the storage service, used to delete the file.
  storageKey String
  width      Int
  height     Int
  alt        String   @default("")
  /// 0 is the cover photo.
  position   Int
  createdAt  DateTime @default(now())
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, position])
}

// ---------- Availability and bookings ----------

enum CancellationPolicy {
  FLEXIBLE
  MODERATE
  STRICT
}

enum BookingStatus {
  PENDING_PAYMENT
  /// Request to book: card authorized, waiting for the owner to accept (holdExpiresAt = the deadline).
  REQUESTED
  CONFIRMED
  CANCELLED
  COMPLETED
}

/// checkIn is inclusive, checkOut is exclusive (the guest leaves that morning),
/// so a stay ending on the 18th and one starting on the 18th do not overlap.
/// A Postgres exclusion constraint (see migration) refuses overlapping active
/// bookings for the same listing.
model Booking {
  id                    String             @id @default(cuid())
  listingId             String
  guestId               String
  checkIn               DateTime           @db.Date
  checkOut              DateTime           @db.Date
  guests                Int
  status                BookingStatus      @default(PENDING_PAYMENT)
  /// Price snapshot at booking time (cents). serviceCents is the guest's 5% service fee.
  nightlyCents          Int
  cleaningCents         Int
  serviceCents          Int
  totalCents            Int
  hostFeeCents          Int                @default(0)
  hostPayoutCents       Int                @default(0)
  /// Lodging taxes at booking time (cents), on nights + cleaning. Included in totalCents.
  /// keyvagaTaxCents: Keyvaga files and keeps it on the platform; ownerTaxCents: passed to the owner, who files it.
  taxCents              Int                @default(0)
  keyvagaTaxCents       Int                @default(0)
  ownerTaxCents         Int                @default(0)
  /// [{ name, ratePpm, cents, filedBy, state, city }] snapshot of the rates applied.
  taxLines              Json?
  /// Tax kept after a cancellation (part of the retained money); null while not cancelled.
  taxRetainedCents      Int?
  paymentRequests       PaymentRequest[]
  /// When Keyvaga blocked these dates on the linked Hospitable calendar (so other channels close).
  hospitableBlockedAt   DateTime?
  currency              String             @default("USD") @db.Char(3)
  cancellationPolicy    CancellationPolicy @default(MODERATE)
  /// Payment plan: dueNowCents at booking; balanceCents charged on balanceDueDate (null = paid in full).
  dueNowCents           Int                @default(0)
  balanceCents          Int                @default(0)
  balanceDueDate        DateTime?          @db.Date
  balanceStatus         BalanceStatus      @default(NONE)
  balanceAttempts       Int                @default(0)
  /// While PENDING_PAYMENT the dates are held until this time.
  holdExpiresAt         DateTime?
  /// The listing needed the owner's approval when this was booked (request to book).
  isRequest             Boolean            @default(false)
  /// Guest said they're bringing a pet; petFeeCents is part of the stay subtotal like cleaning.
  pets                  Boolean            @default(false)
  petFeeCents           Int                @default(0)
  stripePaymentMethodId String?
  confirmedAt           DateTime?
  cancelledAt           DateTime?
  cancelledBy           String?
  refundedCents         Int                @default(0)
  /// Owner payout after cancellations/adjustments; paid out after check-in.
  payoutDueCents        Int                @default(0)
  payoutStatus          PayoutStatus       @default(NOT_DUE)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  listing               Listing            @relation(fields: [listingId], references: [id])
  guest                 User               @relation("BookingGuest", fields: [guestId], references: [id])
  payments              Payment[]
  messages              Message[]
  review                Review?
  autoMessages          AutoMessageLog[]
  accessCodes           AccessCode[]
  jobs                  Job[]
  /// Guest agreed to the house rules (part of "Before you arrive").
  rulesAcceptedAt       DateTime?
  /// For unread message counts.
  guestLastReadAt       DateTime?
  ownerLastReadAt       DateTime?

  @@index([listingId, checkIn])
  @@index([guestId])
  @@index([status, balanceDueDate])
  @@index([payoutStatus, checkIn])
}

enum BalanceStatus {
  NONE
  SCHEDULED
  PAID
  FAILED
  CANCELLED
}

enum PayoutStatus {
  NOT_DUE
  PENDING
  PAID
  NONE
}

enum PaymentKind {
  DEPOSIT
  BALANCE
  FULL
  REFUND
  PAYOUT
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

/// Ledger of every money movement for a booking: guest charges, refunds and owner payouts.
model Payment {
  id             String        @id @default(cuid())
  bookingId      String
  kind           PaymentKind
  amountCents    Int
  status         PaymentStatus @default(PENDING)
  /// Stripe PaymentIntent, Refund or Transfer id.
  stripeId       String?       @unique
  /// For charges: the Stripe charge id (used to fund payouts).
  stripeChargeId String?
  failureMessage String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  booking        Booking       @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
}

enum BlockSource {
  OWNER
  ICAL
  HOSPITABLE
}

/// Dates the owner (or a synced calendar) has blocked. Same [start, end) convention.
model CalendarBlock {
  id        String        @id @default(cuid())
  listingId String
  startDate DateTime      @db.Date
  endDate   DateTime      @db.Date
  source    BlockSource   @default(OWNER)
  note      String?
  /// Set for blocks imported from a synced calendar (replaced on every sync).
  feedId    String?
  createdAt DateTime      @default(now())
  listing   Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  feed      CalendarFeed? @relation(fields: [feedId], references: [id], onDelete: Cascade)

  @@index([listingId, startDate])
}

/// One conversation per booking between the guest and the host.
model Message {
  id        String   @id @default(cuid())
  bookingId String
  senderId  String
  body      String
  /// Sent automatically from an owner message template.
  automated Boolean  @default(false)
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id])

  @@index([bookingId, createdAt])
}

/// A guest's review of a completed stay. One per booking.
model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  listingId String
  guestId   String
  rating    Int
  body      String
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  guest     User     @relation(fields: [guestId], references: [id])

  @@index([listingId, createdAt])
}

model SavedListing {
  userId    String
  listingId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
}

// ---------- Service marketplace (Phase 5) ----------

enum ProviderStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  PAUSED
}

/// A service provider's business profile. Visible to owners only once an admin approves it.
model ProviderProfile {
  id               String          @id @default(cuid())
  userId           String          @unique
  slug             String          @unique
  businessName     String
  bio              String          @default("")
  /// Category keys from src/lib/services.ts
  categories       String[]        @default([])
  /// Cities/towns served, lowercased for matching; display list in serviceAreaText.
  serviceAreas     String[]        @default([])
  serviceAreaText  String          @default("")
  region           String          @default("")
  pricingGuidance  String          @default("")
  /// Short availability note shown on cards, e.g. "Same-day available".
  availabilityNote String          @default("")
  status           ProviderStatus  @default(DRAFT)
  reviewNote       String?
  submittedAt      DateTime?
  approvedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos           ProviderPhoto[]
  quotes           Quote[]
  directJobs       Job[]           @relation("JobTargetProvider")
  regularFor       Listing[]       @relation("RegularCleaner")
  jobMessages      JobMessage[]

  @@index([status, region])
}

model ProviderPhoto {
  id         String          @id @default(cuid())
  providerId String
  url        String
  storageKey String
  width      Int
  height     Int
  position   Int
  createdAt  DateTime        @default(now())
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, position])
}

enum JobStatus {
  OPEN
  ASSIGNED
  COMPLETED
  PAID
  DISPUTED
  CANCELLED
}

/// A job an owner needs done at a property. DIRECT when sent to one provider; otherwise open to matching providers.
model Job {
  id                  String             @id @default(cuid())
  ownerId             String
  listingId           String
  bookingId           String?
  category            String
  title               String
  description         String
  preferredDate       DateTime?          @db.Date
  flexibleDate        Boolean            @default(true)
  targetProviderId    String?
  status              JobStatus          @default(OPEN)
  acceptedQuoteId     String?            @unique
  scheduledDate       DateTime?          @db.Date
  /// Money snapshot at acceptance (cents).
  quoteCents          Int                @default(0)
  ownerFeeCents       Int                @default(0)
  ownerTotalCents     Int                @default(0)
  providerFeeCents    Int                @default(0)
  providerPayoutCents Int                @default(0)
  completedAt         DateTime?
  completionNote      String?
  /// Auto-release to the provider after this time unless the owner reports a problem.
  releaseAfter        DateTime?
  paidOutAt           DateTime?
  disputeNote         String?
  cancelledAt         DateTime?
  cancelledBy         String?
  ownerLastReadAt     DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  owner               User               @relation("JobOwner", fields: [ownerId], references: [id])
  listing             Listing            @relation(fields: [listingId], references: [id])
  booking             Booking?           @relation(fields: [bookingId], references: [id])
  targetProvider      ProviderProfile?   @relation("JobTargetProvider", fields: [targetProviderId], references: [id])
  quotes              Quote[]            @relation("JobQuotes")
  acceptedQuote       Quote?             @relation("AcceptedQuote", fields: [acceptedQuoteId], references: [id])
  messages            JobMessage[]
  reviews             JobReview[]
  payments            JobPayment[]
  accessCodes         AccessCode[]
  checklist           JobChecklistItem[]
  photos              JobPhoto[]
  /// Snapshot of the listing's minimum photo count when the checklist was created.
  minPhotos           Int                @default(0)

  @@index([status, category])
  @@index([ownerId])
}

enum QuoteStatus {
  SUBMITTED
  ACCEPTED
  DECLINED
  WITHDRAWN
}

model Quote {
  id           String          @id @default(cuid())
  jobId        String
  providerId   String
  amountCents  Int
  proposedDate DateTime?       @db.Date
  message      String          @default("")
  status       QuoteStatus     @default(SUBMITTED)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  job          Job             @relation("JobQuotes", fields: [jobId], references: [id], onDelete: Cascade)
  provider     ProviderProfile @relation(fields: [providerId], references: [id])
  acceptedFor  Job?            @relation("AcceptedQuote")

  @@unique([jobId, providerId])
  @@index([providerId, status])
}

/// Conversation between the job's owner and one provider (one thread per job + provider).
model JobMessage {
  id         String          @id @default(cuid())
  jobId      String
  providerId String
  senderId   String
  body       String
  createdAt  DateTime        @default(now())
  job        Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  provider   ProviderProfile @relation(fields: [providerId], references: [id])
  sender     User            @relation(fields: [senderId], references: [id])

  @@index([jobId, providerId, createdAt])
}

/// Reviews after a paid job: owner reviews the provider and the provider reviews the owner.
model JobReview {
  id         String   @id @default(cuid())
  jobId      String
  reviewerId String
  /// "PROVIDER" when the owner reviews the provider; "OWNER" when the provider reviews the owner.
  subject    String
  rating     Int
  body       String
  createdAt  DateTime @default(now())
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reviewer   User     @relation("JobReviewer", fields: [reviewerId], references: [id])

  @@unique([jobId, reviewerId])
}

enum JobPaymentKind {
  CHARGE
  REFUND
  PAYOUT
}

/// Money movements for a service job (Stripe PaymentIntent, Refund or Transfer).
model JobPayment {
  id             String         @id @default(cuid())
  jobId          String
  kind           JobPaymentKind
  amountCents    Int
  status         PaymentStatus  @default(PENDING)
  stripeId       String?        @unique
  stripeChargeId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  job            Job            @relation(fields: [jobId], references: [id])

  @@index([jobId])
}

// ---------- Automated guest messages ----------

enum MessageTrigger {
  BOOKING_CONFIRMED
  BEFORE_CHECKIN
  CHECKIN_DAY
  BEFORE_CHECKOUT
  AFTER_CHECKOUT
}

/// An owner's automated message, sent to every matching booking. listingId null = all the owner's listings.
model MessageTemplate {
  id         String           @id @default(cuid())
  ownerId    String
  listingId  String?
  name       String
  trigger    MessageTrigger
  /// Days before (BEFORE_CHECKIN, BEFORE_CHECKOUT) or after (AFTER_CHECKOUT) the event.
  offsetDays Int              @default(0)
  body       String
  enabled    Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  owner      User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  listing    Listing?         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  logs       AutoMessageLog[]

  @@index([ownerId])
}

/// Records that a template was sent for a booking, so it's never sent twice.
model AutoMessageLog {
  id         String          @id @default(cuid())
  bookingId  String
  templateId String
  messageId  String?
  sentAt     DateTime        @default(now())
  booking    Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  template   MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([bookingId, templateId])
}

/// One-time password reset links. Only a SHA-256 hash of the token is stored; links expire after an hour.
model PasswordResetToken {
  id        String    @id
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Smart locks (via Seam) ----------

/// A lock-brand account the owner connected through Seam (e.g. their Schlage account).
model LockAccount {
  id            String   @id @default(cuid())
  ownerId       String
  seamAccountId String   @unique
  provider      String
  label         String   @default("")
  createdAt     DateTime @default(now())
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  locks         Lock[]

  @@index([ownerId])
}

model Lock {
  id            String       @id @default(cuid())
  ownerId       String
  lockAccountId String
  seamDeviceId  String       @unique
  name          String
  provider      String
  online        Boolean      @default(true)
  /// Which property this lock opens. Codes are created on every lock assigned to the booked listing.
  listingId     String?
  /// Owner-provided fallback code shown to booked guests if their code can't be set or the lock is offline.
  backupCode    String?
  lastSyncedAt  DateTime?
  createdAt     DateTime     @default(now())
  owner         User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  account       LockAccount  @relation(fields: [lockAccountId], references: [id], onDelete: Cascade)
  listing       Listing?     @relation(fields: [listingId], references: [id], onDelete: SetNull)
  accessCodes   AccessCode[]
  events        LockEvent[]

  @@index([listingId])
}

enum AccessCodeStatus {
  SETTING
  SET
  FAILED
  REMOVED
}

/// A time-limited door code for a guest's stay or a service job window.
model AccessCode {
  id         String           @id @default(cuid())
  lockId     String
  bookingId  String?
  jobId      String?
  seamCodeId String?          @unique
  code       String?
  name       String
  startsAt   DateTime
  endsAt     DateTime
  status     AccessCodeStatus @default(SETTING)
  error      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  lock       Lock             @relation(fields: [lockId], references: [id], onDelete: Cascade)
  booking    Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  job        Job?             @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([jobId])
  @@index([lockId, startsAt])
}

/// Activity log for the Connections page: syncs, codes created/removed, and errors (with retry).
model LockEvent {
  id         String    @id @default(cuid())
  ownerId    String
  lockId     String?
  bookingId  String?
  jobId      String?
  kind       String
  message    String
  retryable  Boolean   @default(false)
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  lock       Lock?     @relation(fields: [lockId], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt])
}

/// A pending "connect your lock account" flow (Seam Connect Webview), so we can finish it on return.
model LockConnectSession {
  id        String   @id
  ownerId   String
  createdAt DateTime @default(now())
}

// ---------- Cleaning checklist with photo proof ----------

model JobChecklistItem {
  id       String    @id @default(cuid())
  jobId    String
  position Int
  label    String
  doneAt   DateTime?
  job      Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, position])
}

/// Private photo a provider uploads as proof of work. Served only to the job's owner, the hired provider and admins.
model JobPhoto {
  id          String   @id @default(cuid())
  jobId       String
  uploaderId  String
  fileKey     String
  contentType String
  caption     String   @default("")
  createdAt   DateTime @default(now())
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  uploader    User     @relation(fields: [uploaderId], references: [id])

  @@index([jobId, createdAt])
}

// ---------- Calendar sync (iCal) ----------

/// Another calendar (Airbnb, Vrbo, Booking.com, Hospitable, OwnerRez...) whose busy dates block this listing.
model CalendarFeed {
  id           String          @id @default(cuid())
  listingId    String
  name         String
  url          String
  provider     String          @default("other")
  lastSyncedAt DateTime?
  lastStatus   String?
  lastError    String?
  eventCount   Int             @default(0)
  createdAt    DateTime        @default(now())
  listing      Listing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  blocks       CalendarBlock[]

  @@unique([listingId, url])
}

// ---------- Security ----------

/**
 * One-time link to confirm an email address. Stored hashed, like password reset tokens.
 */
model EmailVerificationToken {
  id        String    @id
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/**
 * Fixed-window counters for rate limiting (login attempts, sign-ups, emails).
 */
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}


enum TaxFiler {
  KEYVAGA
  OWNER
}

/// Lodging tax rates, entered by an admin. A rate applies to listings in `state` (2-letter code) and,
/// when `city` is set, only to listings in that town. Several rates can stack (state + county + city).
model TaxRate {
  id        String   @id @default(cuid())
  state     String
  /// Empty = the whole state.
  city      String   @default("")
  /// Shown on receipts and the tax report, e.g. "Baldwin County lodging tax".
  name      String
  /// Percent in parts per million: 4.5% = 45000.
  ratePpm   Int
  filedBy   TaxFiler @default(KEYVAGA)
  notes     String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state, active])
}


enum PaymentRequestStatus {
  REQUESTED
  PAID
  DECLINED
  CANCELLED
  REFUNDED
}

/// Extra money an owner asks a guest to pay for a booking (parking pass, beach gear...). The guest approves
/// and pays; Keyvaga holds it and pays the owner (amount − host fee + owner-filed tax) once the stay has started.
model PaymentRequest {
  id                    String               @id @default(cuid())
  bookingId             String
  description           String
  /// Amount the owner asked for, before tax.
  amountCents           Int
  taxCents              Int                  @default(0)
  keyvagaTaxCents       Int                  @default(0)
  ownerTaxCents         Int                  @default(0)
  taxLines              Json?
  /// What the guest pays: amount + tax.
  totalCents            Int
  /// 5% of the amount, at least $1.
  hostFeeCents          Int
  ownerPayoutCents      Int
  status                PaymentRequestStatus @default(REQUESTED)
  stripePaymentIntentId String?              @unique
  stripeChargeId        String?
  paidAt                DateTime?
  stripeTransferId      String?
  paidOutAt             DateTime?
  refundedAt            DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  booking               Booking              @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@index([status, paidOutAt])
}

/// Owners who asked to list before Keyvaga opens to new owners (soft launch).
model OwnerWaitlist {
  id            String   @id @default(cuid())
  name          String
  email         String
  phone         String   @default("")
  company       String   @default("")
  propertyCount Int      @default(1)
  locations     String   @default("")
  software      String   @default("")
  notes         String   @default("")
  contactedAt   DateTime?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([email])
}

/// A condo building or resort (e.g. "Crystal Shores West"). Created when an owner names it on a listing.
model Complex {
  id          String    @id @default(cuid())
  /// slugify(name + city + region), so the same building typed twice is one complex.
  slug        String    @unique
  name        String
  city        String
  region      String
  description String    @default("")
  createdAt   DateTime  @default(now())
  listings    Listing[]

  @@index([city, region])
}
