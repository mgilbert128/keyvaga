// Keyvaga data model: Phase 1 (accounts, roles, sessions) plus the first
// listing and booking tables. More models (payments, messages, services,
// connections) arrive in later phases.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Accounts ----------

enum Role {
  GUEST
  OWNER
  PROVIDER
  ADMIN
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  roles        UserRole[]
  sessions     Session[]
  listings     Listing[]  @relation("ListingOwner")
  bookings     Booking[]  @relation("BookingGuest")
  /// Stripe customer used to save the guest's card for the balance charge.
  stripeCustomerId     String? @unique
  /// Stripe Connect account that receives the owner's payouts.
  stripeAccountId      String? @unique
  payoutsEnabled       Boolean @default(false)
}

/// One person can hold several roles (e.g. a guest who is also an owner).
model UserRole {
  userId    String
  role      Role
  grantedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
}

/// Server-side sessions. `id` is the SHA-256 hash of the cookie token,
/// so a database leak does not expose usable session tokens.
model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Listings ----------

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  PAUSED
}

enum PropertyType {
  HOUSE
  APARTMENT
  CABIN
  CONDO
  VILLA
  OTHER
}

model Listing {
  id               String          @id @default(cuid())
  ownerId          String
  slug             String          @unique
  title            String
  summary          String
  description      String          @default("")
  propertyType     PropertyType
  city             String
  region           String
  country          String          @default("US")
  bedrooms         Int
  bathrooms        Decimal         @db.Decimal(3, 1)
  maxGuests        Int
  /// All money is stored in minor units (cents). Launch currency is USD.
  nightlyRateCents Int
  cleaningFeeCents Int             @default(0)
  currency         String          @default("USD") @db.Char(3)
  /// Instant book is the launch default; kept per listing so request-to-book can be added later.
  instantBook      Boolean         @default(true)
  minNights        Int             @default(1)
  cancellationPolicy CancellationPolicy @default(MODERATE)
  /// Amenity keys from the catalog in src/lib/amenities.ts
  amenities        String[]        @default([])
  houseRules       String          @default("")
  /// "HH:MM" 24-hour local time
  checkInTime      String          @default("16:00")
  checkOutTime     String          @default("10:00")
  /// Exact address: private, only released to guests with a confirmed booking (Phase 4).
  addressLine1     String          @default("")
  addressLine2     String          @default("")
  postalCode       String          @default("")
  latitude         Float?
  longitude        Float?
  status           ListingStatus   @default(DRAFT)
  /// Feedback from the admin when a listing is sent back to the owner.
  reviewNote       String?
  submittedAt      DateTime?
  publishedAt      DateTime?
  featured         Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  owner            User            @relation("ListingOwner", fields: [ownerId], references: [id])
  bookings         Booking[]
  calendarBlocks   CalendarBlock[]
  photos           ListingPhoto[]
  /// Optional short video tour (max 20 seconds). videoKey is the storage pathname.
  videoKey         String?
  /// Direct URL for public/local storage; private stores get a short-lived signed URL at view time.
  videoUrl         String?
  videoAccess      String?
  videoContentType String?
  videoDurationSec Float?

  @@index([status, city])
  @@index([ownerId])
}

model ListingPhoto {
  id         String   @id @default(cuid())
  listingId  String
  url        String
  /// Key in the storage service, used to delete the file.
  storageKey String
  width      Int
  height     Int
  alt        String   @default("")
  /// 0 is the cover photo.
  position   Int
  createdAt  DateTime @default(now())
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, position])
}

// ---------- Availability and bookings ----------

enum CancellationPolicy {
  FLEXIBLE
  MODERATE
  STRICT
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
}

/// checkIn is inclusive, checkOut is exclusive (the guest leaves that morning),
/// so a stay ending on the 18th and one starting on the 18th do not overlap.
/// A Postgres exclusion constraint (see migration) refuses overlapping active
/// bookings for the same listing.
model Booking {
  id                 String             @id @default(cuid())
  listingId          String
  guestId            String
  checkIn            DateTime           @db.Date
  checkOut           DateTime           @db.Date
  guests             Int
  status             BookingStatus      @default(PENDING_PAYMENT)
  /// Price snapshot at booking time (cents). serviceCents is the guest's 5% service fee.
  nightlyCents       Int
  cleaningCents      Int
  serviceCents       Int
  totalCents         Int
  hostFeeCents       Int                @default(0)
  hostPayoutCents    Int                @default(0)
  currency           String             @default("USD") @db.Char(3)
  cancellationPolicy CancellationPolicy @default(MODERATE)
  /// Payment plan: dueNowCents at booking; balanceCents charged on balanceDueDate (null = paid in full).
  dueNowCents        Int                @default(0)
  balanceCents       Int                @default(0)
  balanceDueDate     DateTime?          @db.Date
  balanceStatus      BalanceStatus      @default(NONE)
  balanceAttempts    Int                @default(0)
  /// While PENDING_PAYMENT the dates are held until this time.
  holdExpiresAt      DateTime?
  stripePaymentMethodId String?
  confirmedAt        DateTime?
  cancelledAt        DateTime?
  cancelledBy        String?
  refundedCents      Int                @default(0)
  /// Owner payout after cancellations/adjustments; paid out after check-in.
  payoutDueCents     Int                @default(0)
  payoutStatus       PayoutStatus       @default(NOT_DUE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  listing            Listing            @relation(fields: [listingId], references: [id])
  guest              User               @relation("BookingGuest", fields: [guestId], references: [id])
  payments           Payment[]

  @@index([listingId, checkIn])
  @@index([guestId])
  @@index([status, balanceDueDate])
  @@index([payoutStatus, checkIn])
}

enum BalanceStatus {
  NONE
  SCHEDULED
  PAID
  FAILED
  CANCELLED
}

enum PayoutStatus {
  NOT_DUE
  PENDING
  PAID
  NONE
}

enum PaymentKind {
  DEPOSIT
  BALANCE
  FULL
  REFUND
  PAYOUT
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

/// Ledger of every money movement for a booking: guest charges, refunds and owner payouts.
model Payment {
  id          String        @id @default(cuid())
  bookingId   String
  kind        PaymentKind
  amountCents Int
  status      PaymentStatus @default(PENDING)
  /// Stripe PaymentIntent, Refund or Transfer id.
  stripeId    String?       @unique
  /// For charges: the Stripe charge id (used to fund payouts).
  stripeChargeId String?
  failureMessage String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  booking     Booking       @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
}

enum BlockSource {
  OWNER
  ICAL
  HOSPITABLE
}

/// Dates the owner (or a synced calendar) has blocked. Same [start, end) convention.
model CalendarBlock {
  id        String      @id @default(cuid())
  listingId String
  startDate DateTime    @db.Date
  endDate   DateTime    @db.Date
  source    BlockSource @default(OWNER)
  note      String?
  createdAt DateTime    @default(now())
  listing   Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, startDate])
}
